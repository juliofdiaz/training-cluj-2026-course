process {
    withName: 'FASTP' {
        container = 'quay.io/biocontainers/fastp:1.4.0--h43da1c4_0'
        cpus      = 1
        memory    = 1.GB
    }
}

profiles {
    docker { docker.enabled = true }
    big {
        process {
            withName: 'FASTP' { cpus = 4; memory = 4.GB }
        }
    }
}
