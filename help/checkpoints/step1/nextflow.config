params {
    input      = null
    fastp_args = '--detect_adapter_for_pe --length_required 50'
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}

// Copy published files out of work/ (the default, 'symlink', breaks when work/ is cleaned)
workflow.output.mode = 'copy'
