/*
 * Default resources, by label (same label names as nf-core, so the habit
 * transfers). resourceLimits in a profile caps these on small machines.
 */
process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h

    // Cap every request to what this machine can give: at most 4 CPUs and 14 GB, and never
    // more than the machine has (a 2-CPU, 8 GB machine gets 2 CPUs and about 6.5 GB).
    // Without a cap, a task asking for 8 CPUs on a smaller machine would never start.
    // A profile for a bigger machine can raise this.
    resourceLimits = [
        cpus:   Math.min(4, Runtime.getRuntime().availableProcessors()),
        memory: [14.GB, (java.lang.management.ManagementFactory.getOperatingSystemMXBean().getTotalMemorySize() * 0.85) as MemoryUnit].min(),
        time:   4.h
    ]

    // Retry once with more memory if a task is killed for exceeding it
    // (exit codes 137/140 = killed by the OS / scheduler)
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_single' { cpus = 1;                  memory = { 2.GB  * task.attempt } }
    withLabel: 'process_low'    { cpus = 2;                  memory = { 4.GB  * task.attempt } }
    withLabel: 'process_medium' { cpus = 4;                  memory = { 8.GB  * task.attempt } }
    withLabel: 'process_high'   { cpus = 8;                  memory = { 16.GB * task.attempt }; time = 4.h }
}
