/*
 * bactflow — configuration
 * Precedence (highest first): command line > -params-file > -c custom.config
 *                             > profiles > this file
 */

manifest {
    name            = 'bactflow (checkpoint 2)'
    description     = 'Teaching pipeline: QC, assembly, typing and AMR screening of bacterial isolates'
    version         = '1.0.0'
    nextflowVersion = '!>=26.04.0'
    homePage        = 'https://github.com/juliofdiaz/training-cluj-2026-course'
}

params {
    input        = null            // samplesheet CSV: sample,fastq_1,fastq_2
    genome_size  = '2.8M'          // used by Shovill for read subsampling
    save_trimmed = false
    fastp_args   = '--detect_adapter_for_pe --length_required 50'
    // Course mode: 2 k-mers, no read correction, no read stitching, no polishing.
    // About 3x faster than Shovill's defaults; tested on the course data: the same
    // STs and AMR genes, slightly more fragmented. For real work: '--minlen 200' alone.
    shovill_args = '--minlen 200 --kmers 31,45 --noreadcorr --nostitch --nocorr'
    outdir       = 'results'
    run_stamp    = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

outputDir = params.outdir

// Copy published files out of work/. The default ('symlink') leaves results
// pointing into work/: clean work/ and your results disappear.
workflow.output.mode = 'copy'

includeConfig 'conf/base.config'

// Provenance & performance reports: always on. They record how each run went
// (time, CPU, memory per task), so do not switch them off. One set of files per run.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${params.run_stamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${params.run_stamp}.html" }
trace    {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${params.run_stamp}.tsv"
    fields  = 'task_id,hash,native_id,process,tag,status,exit,attempt,cpus,memory,time,realtime,%cpu,peak_rss,rchar,wchar,duration,submit,start,complete'
}
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${params.run_stamp}.html" }

profiles {
    docker {
        docker.enabled  = true
        // Run as your own user so result files are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
}
