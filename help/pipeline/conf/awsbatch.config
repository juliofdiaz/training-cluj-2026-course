/*
 * AWS Batch profile. Values in <angle brackets> are provided by the
 * instructor (see instructor/aws-setup.md). Participants normally only
 * change the bucket prefix, via the environment variable COURSE_USER.
 *
 *   export COURSE_USER=alice
 *   nextflow run main.nf -profile awsbatch --input s3://<bucket>/data/samplesheet_s3.csv
 */
process {
    executor = 'awsbatch'
    queue    = env('COURSE_QUEUE') ?: 'course-spot-queue'
    // Spot instances can be reclaimed: retry on any failure, up to 3 times
    errorStrategy = 'retry'
    maxRetries    = 3
    resourceLimits = [cpus: 16, memory: 32.GB, time: 4.h]
}

aws {
    region = env('AWS_REGION') ?: 'eu-central-1'
    batch {
        // The AMI/launch template has the AWS CLI installed here
        cliPath          = '/home/ec2-user/miniconda/bin/aws'
        maxSpotAttempts  = 3
    }
}

docker.enabled = true

// Each participant gets their own prefix in the shared course bucket
workDir       = "${env('COURSE_BUCKET') ?: 's3://<course-bucket>'}/work/${env('COURSE_USER') ?: 'unnamed'}"
params.outdir = "${env('COURSE_BUCKET') ?: 's3://<course-bucket>'}/results/${env('COURSE_USER') ?: 'unnamed'}"
outputDir     = params.outdir
// The species database (Day 2 module) is read from the bucket, not from the course machine
params.mash_db = "${env('COURSE_BUCKET') ?: 's3://<course-bucket>'}/databases/refseq.genomes.k21s1000.msh"
